{
  "name": "kcdc-playground",
  "version": "1.0.0",
  "private": true,
  "description": "Optional development playground for the sample game mode",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p src/client/tsconfig.json",
    "test": "npm run build && node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "@kingdomsconnected/types": "1.6.8",
    "typescript": "^5.9.2"
  },
  "mafiahub": {
    "category": "example",
    "resourceDependencies": [
      "kcdc-gamemode"
    ],
    "serverScripts": [
      "dist/server/index.js"
    ],
    "clientScripts": [
      "dist/client/index.js"
    ],
    "files": [
      "dist/client/**",
      "ui/**"
    ],
    "priority": 20
  }
}
